{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "lib": [
      "es2020",
      "dom"
    ],
    "declaration": false,
    "sourceMap": true,
    "outDir": "./out-tsc",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "types": [],
    "strict": false
  },
  "angularCompilerOptions": {
    "enableIvy": true
  }
}
